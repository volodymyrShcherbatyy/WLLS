generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String             @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String
  isAdmin          Boolean            @default(false)
  nativeLanguageId String?
  targetLanguageId String?
  accounts         Account[]
  sessions         Session[]
  progress         Progress[]
  testResults      TestResult[]
  customLists      CustomList[]
  userWords        UserWord[]
  userWordProgress UserWordProgress[]
  nativeLanguage   Language?          @relation("NativeLanguage", fields: [nativeLanguageId], references: [id])
  targetLanguage   Language?          @relation("TargetLanguage", fields: [targetLanguageId], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Language {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  words                Word[]
  nativeUsers          User[]                @relation("NativeLanguage")
  targetUsers          User[]                @relation("TargetLanguage")
  sentences            Sentence[]
  userWords            UserWord[]
  userWordTranslations UserWordTranslation[] @relation("UserWordTranslatedLanguage")
  createdAt            DateTime              @default(now())
}

model Word {
  id               String           @id @default(cuid())
  languageId       String
  text             String
  imageUrl         String?
  difficulty       Int              @default(1)
  language         Language         @relation(fields: [languageId], references: [id], onDelete: Cascade)
  translationsFrom Translation[]    @relation("WordToTranslation")
  translationsTo   Translation[]    @relation("TranslationToWord")
  progress         Progress[]
  wordSentences    WordSentence[]
  customListWords  CustomListWord[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([languageId, text])
}

model CustomList {
  id        String               @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  listWords CustomListWord[]
  userWords CustomListUserWord[]
}

model CustomListWord {
  id     String     @id @default(cuid())
  listId String
  wordId String
  list   CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  word   Word       @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([listId, wordId])
}

model Translation {
  id               String @id @default(cuid())
  wordId           String
  translatedWordId String
  word             Word   @relation("WordToTranslation", fields: [wordId], references: [id], onDelete: Cascade)
  translatedWord   Word   @relation("TranslationToWord", fields: [translatedWordId], references: [id], onDelete: Cascade)

  @@unique([wordId, translatedWordId])
}

model Sentence {
  id            String         @id @default(cuid())
  text          String
  languageId    String
  language      Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  wordSentences WordSentence[]
}

model WordSentence {
  wordId     String
  sentenceId String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)

  @@id([wordId, sentenceId])
}

model Progress {
  id             String    @id @default(cuid())
  userId         String
  wordId         String
  masteryLevel   Int       @default(0)
  interval       Int       @default(1)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model UserWord {
  id           String                @id @default(cuid())
  userId       String
  languageId   String
  text         String
  imageUrl     String?
  createdAt    DateTime              @default(now())
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     Language              @relation(fields: [languageId], references: [id], onDelete: Cascade)
  translations UserWordTranslation[]
  customLists  CustomListUserWord[]
  progress     UserWordProgress[]

  @@unique([userId, languageId, text])
}

model UserWordTranslation {
  id                   String   @id @default(cuid())
  userWordId           String
  translatedText       String
  translatedLanguageId String
  userWord             UserWord @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  translatedLanguage   Language @relation("UserWordTranslatedLanguage", fields: [translatedLanguageId], references: [id], onDelete: Cascade)

  @@unique([userWordId, translatedLanguageId, translatedText])
}

model CustomListUserWord {
  id         String     @id @default(cuid())
  listId     String
  userWordId String
  list       CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  userWord   UserWord   @relation(fields: [userWordId], references: [id], onDelete: Cascade)

  @@unique([listId, userWordId])
}

model UserWordProgress {
  id             String    @id @default(cuid())
  userId         String
  userWordId     String
  masteryLevel   Int       @default(0)
  interval       Int       @default(1)
  easeFactor     Float     @default(2.5)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWord       UserWord  @relation(fields: [userWordId], references: [id], onDelete: Cascade)

  @@unique([userId, userWordId])
}

model TestResult {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
